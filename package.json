{
  "name": "legend-of-adventure",
  "version": "1.0.0",
  "description": "A procedurally generated MMO",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch index.ts",
    "start": "NODE_ENV=production node index.ts",
    "build:client": "node scripts/clientBuild.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node --test \"test/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattbasta/Legend-of-Adventure.git"
  },
  "author": "Matt Basta <me@mattbasta.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mattbasta/Legend-of-Adventure/issues"
  },
  "homepage": "https://github.com/mattbasta/Legend-of-Adventure#readme",
  "dependencies": {
    "rng": "^0.2.2",
    "ws": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.5.3",
    "buzz": "^1.2.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
